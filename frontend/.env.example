[TEMPLATE]
# Base URL of the FastAPI backend (browser-facing; must be public, never a secret).
#
# Leave EMPTY when the frontend is served from the same origin as the backend
# (the root vercel.json rewrites /api/* to the backend service). Requests then
# use relative paths and there is no CORS configuration to maintain.
#
# Set it only when frontend and backend are deployed as SEPARATE Vercel projects:
# VITE_BACKEND_URL=https://compliance-checkpoint-backend.vercel.app
#
# In development the Vite proxy (vite.config.ts) forwards /api to localhost:8000,
# so leaving it empty also works locally.
VITE_BACKEND_URL=
