[TEMPLATE]
# REQUIRED - Database
# Copy this file to .env and fill in real values.
# Do NOT commit .env and do NOT set the placeholder text as the value of
# DATABASE_URL (in .env or in your host's dashboard) - it will fail to parse.
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
# Local example:
#DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/compliance_db
# Neon example (keep ?sslmode=require):
#DATABASE_URL=postgresql://neondb_owner:PASSWORD@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=

# REQUIRED - Security
#SECRET_KEY=your-super-secret-key-change-this-to-something-random-and-long
SECRET_KEY=


# REQUIRED - Frontend URL for CORS
FRONTEND_URL=http://localhost:5173

# OPTIONAL - Not used in current implementation
# AWS_ACCESS_KEY_ID=not-needed
# AWS_SECRET_ACCESS_KEY=not-needed
# AWS_BUCKET_NAME=not-needed
# AWS_REGION=not-needed

